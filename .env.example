# Local demo requires no credentials. Reservations are direct slot confirmations.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Match your final deployed origin, including https://
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://plydeck.vercel.app
# Vercel scheduled WhatsApp worker authorization
CRON_SECRET=

# WhatsApp Cloud API (all server only)
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
